# Archivo de configuración de ejemplo
# Copia este archivo como .env y rellena con tus propias claves

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-anon-key-aqui

# Claves de API para servicios externos
UNSPLASH_ACCESS_KEY=tu-unsplash-access-key-aqui
PIXABAY_API_KEY=tu-pixabay-api-key-aqui 